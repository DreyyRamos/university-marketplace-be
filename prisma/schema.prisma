// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id             String         @id @default(uuid())
  firstName           String
  lastName            String
  email               String         @unique
  password            String
  role                Role           @default(Student)
  user_rating         Int
  profile_image       String
  products_listed     Product[]
  buyerConversations  Conversation[] @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  messages            Message[]
  savedItems          SavedItems[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@map("users")
}

model Product {
  product_id          String         @id @default(cuid())
  product_name        String
  product_price       Int
  product_image       String[]
  product_description String
  product_details     String
  category            Category       @default(Other)
  rating              Int
  condition           Condition
  location            String
  seller_id           String
  seller              User?          @relation(fields: [seller_id], references: [user_id])
  product_status      Status         @default(Active)
  conversations       Conversation[]
  saved               SavedItems[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @default(now())
}

model SavedItems {
  saved_id   String   @id @default(cuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [user_id])
  product_id String
  product    Product  @relation(fields: [product_id], references: [product_id])
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())

  @@unique([user_id, product_id])
}

model Conversation {
  conversation_id      String    @id @default(cuid())
  conversation_preview String
  unread               Boolean   @default(false)
  messages             Message[]
  buyer_id             String
  buyer                User      @relation("BuyerConversations", fields: [buyer_id], references: [user_id])
  seller_id            String
  seller               User      @relation("SellerConversations", fields: [seller_id], references: [user_id])
  product_id           String
  product              Product   @relation(fields: [product_id], references: [product_id])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now())

  @@unique([product_id, buyer_id, seller_id])
  @@index([product_id])
  @@index([buyer_id])
}

model Message {
  message_id      String       @id @default(uuid())
  message_text    String
  conversation_id String
  conversation    Conversation @relation(fields: [conversation_id], references: [conversation_id])
  sender_id       String
  sender          User         @relation(fields: [sender_id], references: [user_id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now())

  @@index([conversation_id])
  @@index([sender_id])
}

enum Category {
  Electronics
  Books
  Furniture
  Clothing
  Sports
  Other
}

enum Condition {
  LIKE_NEW
  GOOD
  STILL_USABLE
}

enum Status {
  Active
  Sold
  Unavailable
}

enum Role {
  Student
  Admin
}
